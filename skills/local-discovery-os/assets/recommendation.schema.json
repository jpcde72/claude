{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldos.local/schemas/recommendation.schema.json",
  "title": "LDOS Gap, Recommendation, Task and ChangeEvent",
  "description": "The judgement chain. Every recommendation cites evidence and declares whether its impact rests on measurement or on judgement.",
  "type": "object",
  "required": ["schema_version", "gap", "recommendation"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "gap": {
      "type": "object",
      "required": ["gap_id", "client_id", "layer", "arena", "metric_key", "evidence_refs", "lost_query_examples"],
      "properties": {
        "gap_id": { "type": "string" },
        "client_id": { "type": "string" },
        "layer": { "enum": ["entity", "surface", "protocol"] },
        "arena": { "enum": ["eligibility", "justification", "defaults"] },
        "metric_key": { "type": "string" },
        "client_value": { "type": "number" },
        "peer_median": { "type": "number" },
        "peer_p75": { "type": "number" },
        "gap_size": { "type": "number", "minimum": 0, "maximum": 1 },
        "structural_or_operational": { "enum": ["structural", "operational"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "lost_query_examples": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "A gap you cannot attach to a lost query, prompt or agent decision is not a gap."
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["recommendation_id", "action_type", "impact", "impact_basis", "effort", "latency_band", "verification_method"],
      "properties": {
        "recommendation_id": { "type": "string" },
        "gap_ids": { "type": "array", "items": { "type": "string" } },
        "action_type": {
          "enum": ["fix_entity_inconsistency", "claim_profile", "merge_duplicate", "change_primary_category", "add_category", "add_attribute", "update_services", "rewrite_description", "publish_post", "upload_photo_batch", "respond_review", "increase_review_velocity", "rewrite_title", "rewrite_meta", "add_internal_links", "expand_thin_content", "consolidate_cannibalisation", "create_service_city_page", "deploy_schema", "add_sameas_graph", "publish_service_feed", "publish_availability_feed", "expose_booking_endpoint", "adjust_crawler_access", "publish_llms_txt", "remediate_model_error"]
        },
        "description": { "type": "string" },
        "impact": { "enum": ["H", "M", "L"] },
        "impact_basis": {
          "enum": ["effect_estimate", "benchmark", "hypothesis"],
          "description": "The intellectual honesty field. Most local-SEO advice is hypothesis dressed as benchmark."
        },
        "effect_estimate_ref": { "type": ["string", "null"] },
        "effort": { "enum": ["H", "M", "L"] },
        "latency_band": { "enum": ["0-7d", "7-30d", "30-90d", "90d+"] },
        "priority_score": { "type": "number" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "enum": ["suspension_risk", "policy_review_required", "client_operational_change", "engineering_required", "legal_review", "reversible_only_with_effort"] } },
        "verification_method": { "type": "string" },
        "status": { "enum": ["proposed", "approved", "rejected", "in_progress", "shipped", "verified", "reverted"] }
      }
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "owner": { "type": "string" },
        "automation_class": { "enum": ["automate", "assist", "retain"] },
        "due_at": { "type": "string", "format": "date-time" },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "state": { "enum": ["queued", "drafting", "awaiting_approval", "approved", "published", "verifying", "closed"] },
        "output_artefact_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "change_event": {
      "type": "object",
      "required": ["change_id", "shipped_at", "field_changed"],
      "properties": {
        "change_id": { "type": "string" },
        "task_id": { "type": "string" },
        "layer": { "enum": ["entity", "surface", "protocol"] },
        "surface_id": { "type": "string" },
        "field_changed": { "type": "string" },
        "value_before": { "type": ["string", "number", "object", "array", "null"] },
        "value_after": { "type": ["string", "number", "object", "array", "null"] },
        "shipped_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "verification_result": { "enum": ["persisted", "reverted_by_platform", "not_applied", "unknown"] },
        "co_shipped_change_ids": {
          "type": "array", "items": { "type": "string" },
          "description": "Non-empty means the event is confounded and excluded from effect estimation."
        },
        "reversal_of": { "type": ["string", "null"] }
      }
    }
  }
}
